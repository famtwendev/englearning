# Database credentials
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_db_password
POSTGRES_DB=eng_learning_db

# MinIO (S3 compatible storage) credentials
MINIO_ROOT_USER=admin
MINIO_ROOT_PASSWORD=your_minio_password

# Spring Boot application configuration
SPRING_DATASOURCE_URL=jdbc:postgresql://postgres:5432/eng_learning_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=your_db_password

# JWT Security
JWT_SECRET=your_super_secret_jwt_key_at_least_64_bytes_long_for_hs512
JWT_EXPIRATION=86400000
